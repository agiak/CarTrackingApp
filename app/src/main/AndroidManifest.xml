<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the sync wait for a connection that can actually reach the
         internet, instead of failing on a captive-portal Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Storage permissions for downloading files -->
    <!-- For Android 9 and below -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 10+ uses scoped storage, no permission needed -->

    <!--
      The advertising ID, explicitly removed.

      firebase-analytics pulls in play-services-measurement-api, whose own
      manifest declares this permission, so it is merged into the app without
      anyone asking for it. This app shows no ads, measures no campaigns and
      has no attribution to do: Analytics identifies a session by the Firebase
      app-instance ID and FCM by its token, neither of which is the
      advertising ID. Shipping a cross-app tracking identifier we never read
      means declaring it on the Data safety form and answering "yes" to
      Play's advertising ID question for nothing.

      Removing it here makes the answer to that question "no" and keeps it
      true. If an ads or attribution SDK is ever added, delete this block and
      set the declaration back to "yes" — the two have to agree or Play
      blocks the release.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Queries for Android 11+ package visibility -->
    <queries>
        <!-- Query for PDF viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Query for image viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".CarTrackingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_cariboo1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_cariboo1_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarTrackingApp"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <!-- Disable WorkManager's default initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarTrackingApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Entry Activity (Lightweight Overlay) -->
        <activity
            android:name=".widget.QuickEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickEntry.Translucent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Widget Configuration Activity -->
        <activity
            android:name=".widget.QuickAddWidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.CarTrackingApp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Quick Add Widget -->
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_UPDATE_WIDGET" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_WIDGET_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Refill 1x1 Widget -->
        <receiver
            android:name=".widget.RefillWidgetReceiver"
            android:exported="true"
            android:label="@string/refill_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/refill_widget_info" />
        </receiver>

        <!-- Expense 1x1 Widget -->
        <receiver
            android:name=".widget.ExpenseWidgetReceiver"
            android:exported="true"
            android:label="@string/expense_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>

        <!-- Push. Data-only messages are delivered here in every app state,
             which is what lets them reach the in-app notification history. -->
        <service
            android:name=".cloud.push.CaribouMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Only used for messages carrying a `notification` block, e.g. one
             sent by hand from the Firebase console. Keep the channel id equal
             to NotificationHelper.CHANNEL_ID_PUSH. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="caribou_updates" />

        <!-- FileProvider for secure file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

