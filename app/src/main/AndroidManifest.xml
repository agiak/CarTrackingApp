<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Storage permissions for downloading files -->
    <!-- For Android 9 and below -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 10+ uses scoped storage, no permission needed -->

    <!-- Queries for Android 11+ package visibility -->
    <queries>
        <!-- Query for PDF viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Query for image viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>

        <!-- Required: Android Auto host app package visibility -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:name=".CarTrackingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_cariboo1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_cariboo1_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarTrackingApp"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <!-- Declare Android Auto support -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Disable WorkManager's default initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarTrackingApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Entry Activity (Lightweight Overlay) -->
        <!-- exported="true" is required so the Android Auto CarAppService (separate process)
             can launch this activity on the phone when the user taps Add Refill on the car screen. -->
        <activity
            android:name=".widget.QuickEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickEntry.Translucent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Widget Configuration Activity -->
        <activity
            android:name=".widget.QuickAddWidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.CarTrackingApp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Quick Add Widget -->
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_UPDATE_WIDGET" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_WIDGET_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Refill 1x1 Widget -->
        <receiver
            android:name=".widget.RefillWidgetReceiver"
            android:exported="true"
            android:label="@string/refill_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/refill_widget_info" />
        </receiver>

        <!-- Expense 1x1 Widget -->
        <receiver
            android:name=".widget.ExpenseWidgetReceiver"
            android:exported="true"
            android:label="@string/expense_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>

        <!-- FileProvider for secure file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Android Auto: CarAppService entry point -->
        <!-- This service is discovered by the Android Auto host and handles the car-screen UI. -->
        <service
            android:name=".auto.CaribooCarAppService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
            <!-- Required: declares the minimum Car App API level this app supports.
                 Without this meta-data, Android Auto silently ignores the service. -->
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
        </service>

    </application>

</manifest>

