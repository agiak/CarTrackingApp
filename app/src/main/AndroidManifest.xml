            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_palette_midnight_sun"
            android:roundIcon="@mipmap/ic_launcher_palette_midnight_sun"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIconStrawberryMint"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_palette_strawberry_mint"
            android:roundIcon="@mipmap/ic_launcher_palette_strawberry_mint"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- END generated launcher aliases -->

        <!-- Quick Entry Activity (Lightweight Overlay) -->
        <activity
            android:name=".widget.QuickEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickEntry.Translucent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!--
          Widget configuration, shown when the quick-add widget is dropped on
          the home screen and again from its reconfigure gesture.

          Exported because the launcher — another app — is what starts it.
          It does nothing but read EXTRA_APPWIDGET_ID and store which car that
          widget belongs to, and finishes immediately if the id is missing.
        -->
        <activity
            android:name=".widget.QuickAddWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.CarTrackingApp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Quick Add Widget -->
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_UPDATE_WIDGET" />
                <action android:name="com.agcoding.cartrackingapp.ACTION_WIDGET_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Refill 1x1 Widget -->
        <receiver
            android:name=".widget.RefillWidgetReceiver"
            android:exported="true"
            android:label="@string/refill_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/refill_widget_info" />
        </receiver>

        <!-- Expense 1x1 Widget -->
        <receiver
            android:name=".widget.ExpenseWidgetReceiver"
            android:exported="true"
            android:label="@string/expense_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>

        <!-- Push. Data-only messages are delivered here in every app state,
             which is what lets them reach the in-app notification history. -->
        <service
            android:name=".cloud.push.CaribouMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Only used for messages carrying a `notification` block, e.g. one
             sent by hand from the Firebase console. Keep the channel id equal
             to NotificationHelper.CHANNEL_ID_PUSH. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="caribou_updates" />

        <!-- FileProvider for secure file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

