<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the sync wait for a connection that can actually reach the
         internet, instead of failing on a captive-portal Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Storage permissions for downloading files -->
    <!-- For Android 9 and below -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 10+ uses scoped storage, no permission needed -->

    <!--
      The advertising ID, explicitly removed.

      firebase-analytics pulls in play-services-measurement-api, whose own
      manifest declares this permission, so it is merged into the app without
      anyone asking for it. This app shows no ads, measures no campaigns and
      has no attribution to do: Analytics identifies a session by the Firebase
      app-instance ID and FCM by its token, neither of which is the
      advertising ID. Shipping a cross-app tracking identifier we never read
      means declaring it on the Data safety form and answering "yes" to
      Play's advertising ID question for nothing.

      Removing it here makes the answer to that question "no" and keeps it
      true. If an ads or attribution SDK is ever added, delete this block and
      set the declaration back to "yes" — the two have to agree or Play
      blocks the release.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Queries for Android 11+ package visibility -->
    <queries>
        <!-- Query for PDF viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Query for image viewers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".CarTrackingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_cariboo1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_cariboo1_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarTrackingApp"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <!-- Disable WorkManager's default initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarTrackingApp" />

        <!--
            The launcher entry lives in the aliases below, not here.

            Android cannot retint an icon at runtime: the only way the icon can
            follow the chosen palette is one alias per palette, each with its
            own static icon, with exactly one enabled at a time. An activity
            that also carried MAIN/LAUNCHER itself would show up as a second,
            permanent entry next to whichever alias is on.

            MainActivity is still the target of every alias and is still
            started directly by name from NotificationHelper, so nothing that
            points at it has to change.

            Generated by gen_aliases.py from the ColorPalette enum. Entries are
            public component names once shipped — a home screen shortcut points
            at one — so they can be added but never renamed or removed.
        -->
