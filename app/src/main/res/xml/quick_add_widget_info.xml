<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 by default. minResizeHeight drops to one row so the short 4×1 layout in
  QuickAddWidget can actually be reached — without it the launcher refuses to
  make the widget shorter than its minHeight and that layout never appears.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.agcoding.cartrackingapp.widget.QuickAddWidgetConfigActivity"
    android:description="@string/widget_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:previewImage="@mipmap/ic_launcher_cariboo1"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetFeatures="reconfigurable"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
