<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares that this app supports Android Auto via the Car App Library template system.
    This file is referenced in AndroidManifest.xml via meta-data and tells the Android Auto
    host that this app uses the template-based rendering mode (not maps or navigation).
-->
<automotiveApp>
    <uses name="template" />
</automotiveApp>

